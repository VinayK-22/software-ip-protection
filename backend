@app.get("/")
def root():
    return {
        "project": "PRUTVYP1",
        "name": "Software & Application IP Protection System",
        "status": "running",
        "version": "1.0.0",
    }


@app.get("/health")
def health_check(db: sqlite3.Connection = Depends(get_db)):
    try:
        db.execute("SELECT 1")
        return {"status": "healthy", "database": "connected"}
    except Exception as error:
        raise HTTPException(status_code=500, detail=f"Database connection failed: {error}")


# ============================================================
# APPLICATION APIs
# ============================================================

@app.post("/applications", status_code=201)
def create_application(application: ApplicationCreate, db: sqlite3.Connection = Depends(get_db)):
    cursor = db.cursor()
    cursor.execute("""
        INSERT INTO applications (application_name, description, owner_name, country, application_type)
        VALUES (?, ?, ?, ?, ?)
    """, (
        application.application_name,
        application.description,
        application.owner_name,
        application.country,
        application.application_type,
    ))
    return {"message": "Application registered successfully", "application_id": cursor.lastrowid}


@app.get("/applications")
def get_applications(
    limit: int = 50,
    offset: int = 0,
    db: sqlite3.Connection = Depends(get_db),
):
    # Unbounded SELECT * with no LIMIT was the old behavior; it would
    # return every row in the table on every call. Paginated by default.
    cursor = db.cursor()
    cursor.execute(
        "SELECT * FROM applications ORDER BY id DESC LIMIT ? OFFSET ?",
        (limit, offset),
    )
    return [dict(row) for row in cursor.fetchall()]


@app.get("/applications/{application_id}")
def get_application(application_id: int, db: sqlite3.Connection = Depends(get_db)):
    cursor = db.cursor()
    return dict(get_application_or_404(cursor, application_id))


@app.delete("/applications/{application_id}")
def delete_application(application_id: int, db: sqlite3.Connection = Depends(get_db)):
    cursor = db.cursor()
    get_application_or_404(cursor, application_id)
    cursor.execute("DELETE FROM applications WHERE id = ?", (application_id,))
    return {"message": "Application deleted successfully"}


# ============================================================
# IP REQUIREMENTS
# ============================================================

@app.get("/ip-requirements")
def get_ip_requirements(
    country: Optional[str] = None,
    ip_type: Optional[str] = None,
    db: sqlite3.Connection = Depends(get_db),
):
    query = "SELECT * FROM ip_requirements WHERE 1 = 1"
    parameters: list = []

    if country:
        query += " AND (country = ? OR country IS NULL)"
        parameters.append(country)
    if ip_type:
        query += " AND ip_type = ?"
        parameters.append(ip_type)

    query += " ORDER BY id"

    cursor = db.cursor()
    cursor.execute(query, parameters)
    return [dict(row) for row in cursor.fetchall()]


# ============================================================
# RECOMMENDATIONS
# ============================================================

@app.post("/applications/{application_id}/recommendations", status_code=201)
def create_recommendation(
    application_id: int,
    recommendation: RecommendationCreate,
    db: sqlite3.Connection = Depends(get_db),
):
    cursor = db.cursor()
    get_application_or_404(cursor, application_id)

    cursor.execute("""
        INSERT INTO protection_recommendations (application_id, ip_type, recommendation, reason)
        VALUES (?, ?, ?, ?)
    """, (application_id, recommendation.ip_type, recommendation.recommendation, recommendation.reason))

    return {"message": "Recommendation created successfully", "recommendation_id": cursor.lastrowid}


@app.get("/applications/{application_id}/recommendations")
def get_recommendations(application_id: int, db: sqlite3.Connection = Depends(get_db)):
    cursor = db.cursor()
    get_application_or_404(cursor, application_id)

    cursor.execute(
        "SELECT * FROM protection_recommendations WHERE application_id = ? ORDER BY id",
        (application_id,),
    )
    return [dict(row) for row in cursor.fetchall()]


@app.post("/applications/{application_id}/analyze")
def analyze_application(application_id: int, db: sqlite3.Connection = Depends(get_db)):
    """Rule-based (non-AI) IP analysis, driven by IP_RULES above."""
    cursor = db.cursor()
    application = get_application_or_404(cursor, application_id)
    recommendations = build_recommendations(application)

    cursor.execute("DELETE FROM protection_recommendations WHERE application_id = ?", (application_id,))
    cursor.executemany("""
        INSERT INTO protection_recommendations (application_id, ip_type, recommendation, reason)
        VALUES (:application_id, :ip_type, :recommendation, :reason)
    """, [{**item, "application_id": application_id} for item in recommendations])

    return {
        "application_id": application_id,
        "application_name": application["application_name"],
        "country": application["country"],
        "analysis_type": "Rule-based Python analysis",
        "recommendations": recommendations,
    }


