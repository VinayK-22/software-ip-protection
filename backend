"""
PRUTVYP1 - Software & Application IP Protection
Backend API for managing software projects and IP protection requirements.
"""

import sqlite3
from contextlib import asynccontextmanager, contextmanager
from pathlib import Path
from typing import Optional

from fastapi import Depends, FastAPI, HTTPException
from pydantic import BaseModel, ConfigDict

DATABASE = Path("prutvyp1.db")


# ============================================================
# DATABASE CONNECTION / INITIALIZATION
# ============================================================

@contextmanager
def get_db():
    """
    Yields a connection and guarantees it is closed and either
    committed or rolled back, even if an exception is raised.
    Use as a FastAPI dependency: db: sqlite3.Connection = Depends(get_db)
    """
    connection = sqlite3.connect(DATABASE)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA foreign_keys = ON")
    try:
        yield connection
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def initialize_database() -> None:
    """Creates required tables and indexes if they don't already exist."""
    with get_db() as connection:
        cursor = connection.cursor()

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS applications (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                application_name TEXT NOT NULL,
                description TEXT,
                owner_name TEXT NOT NULL,
                country TEXT NOT NULL,
                application_type TEXT NOT NULL,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS ip_requirements (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ip_type TEXT NOT NULL,
                requirement TEXT NOT NULL,
                description TEXT,
                country TEXT
            )
        """)

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS protection_recommendations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                application_id INTEGER NOT NULL,
                ip_type TEXT NOT NULL,
                recommendation TEXT NOT NULL,
                reason TEXT,
                FOREIGN KEY (application_id)
                    REFERENCES applications(id)
                    ON DELETE CASCADE
            )
        """)

        # Indexes: every lookup/join in this file filters or joins on
        # these columns, and none of them were indexed before.
        cursor.execute("""
            CREATE INDEX IF NOT EXISTS idx_recommendations_app_id
            ON protection_recommendations(application_id)
        """)
        cursor.execute("""
            CREATE INDEX IF NOT EXISTS idx_ip_requirements_country
            ON ip_requirements(country)
        """)
        cursor.execute("""
            CREATE INDEX IF NOT EXISTS idx_ip_requirements_type
            ON ip_requirements(ip_type)
        """)


@asynccontextmanager
async def lifespan(app: FastAPI):
    # Runs once at startup instead of at import time — the old
    # module-level initialize_database() call fired even during
    # tests or tooling that merely imported this file.
    initialize_database()
    yield


app = FastAPI(
    title="PRUTVYP1 - Software & Application IP Protection",
    description="Backend API for managing software projects and IP protection requirements.",
    version="1.0.0",
    lifespan=lifespan,
)


# ============================================================
# PYDANTIC MODELS
# ============================================================

class ApplicationCreate(BaseModel):
    application_name: str
    description: Optional[str] = None
    owner_name: str
    country: str
    application_type: str


class ApplicationResponse(ApplicationCreate):
    model_config = ConfigDict(from_attributes=True)
    id: int
    created_at: Optional[str] = None


class RecommendationCreate(BaseModel):
    ip_type: str
    recommendation: str
    reason: Optional[str] = None


class RecommendationResponse(RecommendationCreate):
    model_config = ConfigDict(from_attributes=True)
    id: int
    application_id: int


# ============================================================
# SHARED HELPERS
# ============================================================

def get_application_or_404(cursor: sqlite3.Cursor, application_id: int) -> sqlite3.Row:
    """
    Every endpoint below needs this exact "does the application
    exist" check — pulled out once instead of repeated four times.
    """
    cursor.execute("SELECT * FROM applications WHERE id = ?", (application_id,))
    application = cursor.fetchone()
    if application is None:
        raise HTTPException(status_code=404, detail="Application not found")
    return application


# Rule table for analyze_application(): each old "if any keyword in
# text" block was identical in shape, just with different keywords
# and messages. Expressing that shape as data instead of four
# copy-pasted if-blocks makes adding a fifth IP type a one-line change.
IP_RULES: list[dict] = [
    {
        "keywords": ("software", "application", "source code", "code"),
        "ip_type": "Copyright",
        "recommendation": "Consider copyright protection for the source code and software documentation.",
        "reason": "The application contains original software code.",
    },
    {
        "keywords": ("brand", "name", "logo", "platform"),
        "ip_type": "Trademark",
        "recommendation": "Consider trademark protection for the application name, brand and logo.",
        "reason": "The project may contain brand-identifying elements.",
    },
    {
        "keywords": ("algorithm", "technical solution", "technical innovation", "invention"),
        "ip_type": "Patent",
        "recommendation": "Consider consulting a patent professional regarding patent eligibility.",
        "reason": "The application may contain a potentially innovative technical solution.",
    },
    {
        "keywords": ("confidential", "proprietary", "secret", "internal"),
        "ip_type": "Trade Secret",
        "recommendation": "Consider protecting confidential algorithms, processes or business information as trade secrets.",
        "reason": "The project appears to contain confidential or proprietary information.",
    },
]

DEFAULT_RECOMMENDATION = {
    "ip_type": "General IP Review",
    "recommendation": "Perform a detailed intellectual property review of the software.",
    "reason": "The available information is insufficient to identify a specific protection mechanism.",
}


def build_recommendations(application: sqlite3.Row) -> list[dict]:
    text = " ".join([
        application["application_name"],
        application["description"] or "",
        application["application_type"],
    ]).lower()

    matches = [
        {"ip_type": rule["ip_type"], "recommendation": rule["recommendation"], "reason": rule["reason"]}
        for rule in IP_RULES
        if any(keyword in text for keyword in rule["keywords"])
    ]
    return matches or [DEFAULT_RECOMMENDATION]


